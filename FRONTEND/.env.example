# Base URL for FastAPI Python backend (leave blank to use local Vite proxy, or set to your deployed backend URL)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Server-side proxy URL for local dev / serverless forwarder
AI_PROVIDER=fastapi
FASTAPI_URL=http://127.0.0.1:8000

# Optional: Direct Gemini API key (if using built-in Gemini LLM provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

